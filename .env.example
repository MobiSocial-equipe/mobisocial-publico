# Copie este arquivo para `.env` e preencha com os valores do seu ambiente local.
# O arquivo `.env` esta listado no `.gitignore` e nunca deve ser versionado.

# PostgreSQL (Docker Compose e Spring Boot)
# Dica: use 5433 em DB_PORT se ja houver um PostgreSQL local ocupando a 5432.
DB_HOST=<host_postgres>
DB_PORT=<porta_postgres>
POSTGRES_DB=<nome_do_banco>
POSTGRES_USER=<usuario_postgres>
POSTGRES_PASSWORD=<senha_postgres>

# RabbitMQ (Docker Compose e Spring Boot)
RABBITMQ_HOST=<host_rabbitmq>
RABBITMQ_PORT=<porta_amqp_rabbitmq>
RABBITMQ_DEFAULT_USER=<usuario_rabbitmq>
RABBITMQ_DEFAULT_PASS=<senha_rabbitmq>
